package resources

import "github.com/sheenazien8/deck/internal/deck/ui"

templ Form(title string, fields []ui.FormField) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
		</head>
		<body>
			<h1>{ title }</h1>
			<form method="POST" class="space-y-4">
				for _, field := range fields {
					<div class="field">
						<label for={ field.ID }>{ field.Label }</label>
						<input
							id={ field.ID }
							name={ field.Name }
							type={ field.Type }
							value={ field.Value }
							class="w-full border rounded px-3 py-2"
						/>
					</div>
				}
				<button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">
					Submit
				</button>
			</form>
		</body>
	</html>
}

type FormField struct {
	ID    string
	Name  string
	Label string
	Type  string
	Value string
}
