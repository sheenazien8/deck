package components

templ Button(label string, variant string, attrs map[string]string) {
	<button
		class={ buttonClass(variant) }
		{ attrs... }
	>
		{ label }
	</button>
}

func buttonClass(variant string) string {
	switch variant {
	case "secondary":
		return "inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm"
	case "destructive":
		return "inline-flex items-center justify-center rounded-md bg-red-600 text-white px-4 py-2"
	default:
		return "inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-4 py-2"
	}
}
