package ui

templ Table[T any](headers []string, rows []T, renderRow func(T) templ.Component) {
    <table class="w-full border rounded-md">
        <thead>
            <tr>
                for _, h := range headers {
                    <th class="px-3 py-2 text-left text-sm font-semibold">{ h }</th>
                }
            </tr>
        </thead>
        <tbody>
        for _, row := range rows {
            <tr class="border-t">
                    @renderRow(row)
            </tr>
        }
        </tbody>
    </table>
}

